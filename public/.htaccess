# KDS Offshore — Apache configuration for static export deployed on amen.pt.
#
# This file lives in /public/ so the Next.js static export copies it verbatim
# into /out/.htaccess, which Apache then reads at the document root.
#
# Keep in sync with:
#   - vercel.json     (Vercel deployments)
#   - _redirects      (Netlify / Cloudflare Pages deployments)

# ──────────────────────────────────────────────────────────────────────────────
# 1. Redirects (301 — permanent)
# ──────────────────────────────────────────────────────────────────────────────
#
# Legacy slug from the previous live site: "offshore-and-maritime-consultancy"
# was split into two narrower services on rebuild. Redirect the old URL to the
# nearest equivalent so prior inbound links and search-engine equity persist.

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^services/offshore-and-maritime-consultancy/?$    /services/maritime-decarbonisation/      [R=301,L]
    RewriteRule ^en/services/offshore-and-maritime-consultancy/?$ /en/services/maritime-decarbonisation/   [R=301,L]

    # Force HTTPS (in case the host does not do it at the load-balancer level).
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Force trailing slash to match Next.js `trailingSlash: true`.
    # Skip if the URL already has an extension (e.g. .xml, .txt, .png).
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ──────────────────────────────────────────────────────────────────────────────
# 2. Compression
# ──────────────────────────────────────────────────────────────────────────────

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript text/xml text/plain
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE application/x-font-ttf application/vnd.ms-fontobject font/opentype image/svg+xml
</IfModule>

# ──────────────────────────────────────────────────────────────────────────────
# 3. Cache control
# ──────────────────────────────────────────────────────────────────────────────

<IfModule mod_expires.c>
    ExpiresActive On

    # HTML & data: short cache, must revalidate (so content updates ship fast).
    ExpiresByType text/html                  "access plus 0 seconds"
    ExpiresByType application/json           "access plus 0 seconds"
    ExpiresByType application/xml            "access plus 1 hour"
    ExpiresByType text/plain                 "access plus 1 hour"

    # Static assets: long cache (Next.js fingerprints them).
    ExpiresByType text/css                   "access plus 1 year"
    ExpiresByType application/javascript     "access plus 1 year"
    ExpiresByType image/png                  "access plus 1 year"
    ExpiresByType image/jpeg                 "access plus 1 year"
    ExpiresByType image/webp                 "access plus 1 year"
    ExpiresByType image/svg+xml              "access plus 1 year"
    ExpiresByType image/x-icon               "access plus 1 year"
    ExpiresByType font/woff                  "access plus 1 year"
    ExpiresByType font/woff2                 "access plus 1 year"
</IfModule>

# ──────────────────────────────────────────────────────────────────────────────
# 4. Security headers
# ──────────────────────────────────────────────────────────────────────────────

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# ──────────────────────────────────────────────────────────────────────────────
# 5. AI / search crawlers — leave robots.txt as the canonical source.
# ──────────────────────────────────────────────────────────────────────────────
#
# Do NOT block GPTBot, ClaudeBot, PerplexityBot, Google-Extended here — they
# need access for the site to be cited in AI answers (Google AI Overviews,
# ChatGPT, Perplexity, Gemini). Bot access is managed in /robots.txt.

# ──────────────────────────────────────────────────────────────────────────────
# 6. Custom error pages
# ──────────────────────────────────────────────────────────────────────────────

ErrorDocument 404 /404.html
